# ============================================================
# MatResearcher 环境变量模板（复制为 .env 使用）
# 本文件只含【非敏感】配置，可安全提交到代码仓库。
#
# !! 密钥管理规则 !!
# 所有 API Key 一律放在用户主目录的 ~/.matresearcher/secrets.env
# （代码启动时自动加载，位于项目目录之外，上传/打包代码不会带走密钥）
# 格式示例：
#   DASHSCOPE_API_KEY=sk-xxxxx
#   SCIVERSE_API_KEY=sci_xxxxx
# 也可用系统环境变量（二选一即可，secrets.env 优先级更高）
# ============================================================

# === LLM Configuration ===
# OpenAI-compatible API (supports OpenAI, Qwen, vLLM, Ollama, etc.)
# [当前] 阿里云 DashScope（已验证可用）
LLM_API_BASE=https://llm-svkdmm9vxy5rc316.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-max-2026-05-17

# [备用] 阶跃星辰 StepFun (token plan 月卡)
# LLM_API_BASE=https://api.stepfun.com/v1
# LLM_MODEL=step-3.7-flash

# For local Qwen2.5: LLM_API_BASE=http://localhost:8000/v1  LLM_MODEL=Qwen2.5-72B-Instruct

# === Sciverse API ===
SCIVERSE_API_BASE=https://api.sciverse.space

# === Embedding Model ===
EMBEDDING_MODEL=BAAI/bge-m3
# Local path or HuggingFace hub ID

# === Reranker Model ===
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# === MinerU ===
MINERU_API_URL=http://localhost:8000
# If MinerU runs as a local service; leave empty to use CLI mode

# === Vector Database (ChromaDB) ===
CHROMA_DB_PATH=./data/chroma
# For Milvus: CHROMA_DB_PATH=milvus://localhost:19530

# === Relational Database ===
DB_URL=sqlite:///./data/matresearcher.db
# For PostgreSQL: DB_URL=postgresql://user:pass@localhost:5432/matresearcher

# === Logging ===
LOG_LEVEL=INFO
